#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export HOST_UID="$(id -u)" HOST_GID="$(id -g)"
mkdir -p recordings
args=(-f compose.yaml)
if [[ "${ARI_GPU:-software}" == nvidia ]]; then
    args+=(-f compose.nvidia.yaml)
else
    export LIBGL_ALWAYS_SOFTWARE=1
fi
case "${1:-help}" in
    build) shift; docker compose "${args[@]}" build "$@" ;;
    launch)
        shift
        # The entrypoint keeps terminal signals away from the nodes, so launch must
        # forward Ctrl+C to them itself instead of assuming the terminal did.
        docker compose "${args[@]}" run --rm experiment ros2 launch --noninteractive ari_counting_sim experiment.launch.py "$@"
        ;;
    stop)
        # "docker compose down" does not cover the one-off containers that "run" creates.
        mapfile -t ids < <(docker ps -q --filter "label=com.docker.compose.project.working_dir=$PWD" --filter label=com.docker.compose.oneoff=True)
        if (( ${#ids[@]} )); then docker stop -t 30 "${ids[@]}"; fi
        ;;
    shell) docker compose "${args[@]}" run --rm experiment bash ;;
    run) shift; docker compose "${args[@]}" run --rm experiment "$@" ;;
    rebuild)
        docker compose "${args[@]}" run --rm experiment bash -c 'source /opt/ari_ws/install/setup.bash; colcon build --base-paths /workspace/src --merge-install --build-base /workspace/build --install-base /workspace/install'
        ;;
    *) echo 'Usage: scripts/ari {build [build args]|launch [launch args]|stop|shell|run command...|rebuild}' ;;
esac
